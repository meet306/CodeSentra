    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Critical Vulnerabilities Detected",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(codesentra_findings_total{severity='CRITICAL'}) or vector(0)",
          "legendFormat": "Critical",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "AI Agent Execution Latency (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(codesentra_agent_duration_seconds_bucket[5m])) by (le, agent_name))",
          "legendFormat": "{{agent_name}} (p95)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Findings By Severity",
      "type": "bargauge",
      "targets": [
        {
          "expr": "sum(codesentra_findings_total) by (severity)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
