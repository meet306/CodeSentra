# ==============================================================================
# AI-Powered GitHub Pull Request Code Reviewer - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="CodeSentra AI PR Reviewer"
API_V1_PREFIX=/api/v1

# Groq API Configuration (Free Tier)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Recommended free models: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_RETRIES=3
GROQ_TIMEOUT_SECONDS=30.0

# GitHub Integration
# For Phase 1: GitHub Personal Access Token (classic or fine-grained with repo/read access)
# Required for private repos or to avoid strict unauthenticated rate limits (60 req/hr)
GITHUB_TOKEN=your_github_token_here
GITHUB_API_BASE_URL=https://api.github.com

# Safety & Dry-Run Mode
# Initially true: review feedback is returned via API response and never posted directly
DRY_RUN=true

# PR Diff Processing Limits (Protect free-tier tokens and 8GB RAM memory)
MAX_DIFF_LINES=1200
MAX_DIFF_FILES=25
MAX_TOKENS_PER_CHUNK=3000

# Future Phase Placeholders (Database, Redis, Webhooks)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codesentra
# REDIS_URL=redis://localhost:6379/0
# GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
